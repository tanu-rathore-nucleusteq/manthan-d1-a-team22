# Copy to .env for local runs. Dummy values only: never commit real secrets.
APP_ENV=local
# Inside Docker Compose the host is db:5432; from the laptop use localhost:5434.
DATABASE_URL=postgresql+psycopg://returnright:change-me@db:5432/returnright
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=15000
DB_ECHO=false
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60
GATEWAY_URL=http://gateway:8001
GATEWAY_TIMEOUT_SECONDS=2
GATEWAY_MAX_RETRIES=2
UPLOAD_DIR=/data/uploads
UPLOAD_MAX_MB=5
FINANCE_APPROVAL_THRESHOLD_INR=10000
CORS_ORIGINS=http://localhost:5173
