# Fault switches for demos and the SRE drill. Change at runtime with POST /admin/faults.
GATEWAY_LATENCY_MS=0
GATEWAY_ERROR_RATE=0.0
GATEWAY_DOWN=false
# Where processed payments are kept. Empty keeps them in memory (forgotten on restart).
GATEWAY_DATABASE_URL=postgresql://returnright:change-me@db:5432/returnright
# When set, POST /admin/faults needs the X-Admin-Token header. Dummy value only.
GATEWAY_ADMIN_TOKEN=
