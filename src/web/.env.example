# Copy to .env.local. Dummy values only; never commit real secrets.

# true (default): every screen runs on the in-browser mock, no API needed.
# false: every screen calls the FastAPI service under /api/v1.
VITE_USE_MOCKS=true

# Leave empty in dev: the Vite proxy forwards /api to API_PROXY_TARGET.
# Set it when the web app and the API are on different origins (e.g. a built image).
VITE_API_BASE_URL=

# Where the dev proxy sends /api requests (inside Docker Compose: http://api:8000).
API_PROXY_TARGET=http://127.0.0.1:8000
