# Docker Compose settings. Copy to .env at the repository root. Dummy values only.
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string
# Password the seed script gives the demo staff users (warehouse1, finance1, manager1).
DEMO_PASSWORD=change-me-demo
# When set, the gateway's POST /admin/faults needs the X-Admin-Token header.
GATEWAY_ADMIN_TOKEN=
# Host ports; change one if it is already taken on your laptop.
DB_PORT=5434
API_PORT=8000
GATEWAY_PORT=8001
WEB_PORT=8080
