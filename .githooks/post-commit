#!/bin/sh
# Rebuild docs/COMMITS.md from the git history after every commit.
# The updated file is left as a change and goes into your next commit.
# Enable once per clone:  git config core.hooksPath .githooks

ROOT=$(git rev-parse --show-toplevel) || exit 0
OUT="$ROOT/docs/COMMITS.md"
BRANCH=$(git branch --show-current)
TOTAL=$(git rev-list --count HEAD 2>/dev/null || echo 0)
mkdir -p "$ROOT/docs"

{
  echo "# Commit Log"
  echo
  echo "All commits on branch \`$BRANCH\`, newest first ($TOTAL total)."
  echo "Regenerated automatically by \`.githooks/post-commit\`. Do not edit by hand."
  echo
  echo "| # | Commit | Date | Author | Message |"
  echo "|---|--------|------|--------|---------|"
  if [ "$TOTAL" -gt 0 ]; then
    git log --date=format:'%Y-%m-%d %H:%M' --format='%h%x09%ad%x09%an%x09%s' |
      awk -F '\t' -v n="$TOTAL" '{ gsub(/\|/, "\\|", $4); printf "| %d | `%s` | %s | %s | %s |\n", n--, $1, $2, $3, $4 }'
  fi
} > "$OUT"

exit 0
